#!/bin/bash
[ -f .env ] && source .env

# export S3_INPUT_PATH="s3://nesta-ds-projects/<MISSION OR PRACTICE>/<PROJECT NAME>"
# For Windows users, use bash to run scripts
export OMP_NUM_THREADS=$(sysctl -n hw.physicalcpu)
# Activate the conda environment
eval "$(conda shell.bash activate "asf_heat_pump_suitability")"
[ "$CONDA_DEFAULT_ENV" = "asf_heat_pump_suitability" ] || echo "Have you run \`make install\`?"
